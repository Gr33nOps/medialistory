{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://mygamelist-ffyl.onrender.com/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://mygamelist-ffyl.onrender.com/health"
    },
    {
      "source": "/ready",
      "destination": "https://mygamelist-ffyl.onrender.com/ready"
    },
    {
      "source": "/",
      "destination": "/Frontend/home.html"
    },
    {
      "source": "/index.html",
      "destination": "/Frontend/home.html"
    },
    {
      "source": "/(.*)",
      "destination": "/Frontend/$1"
    }
  ]
}
