{
  "name": "medialistory",
  "version": "1.0.0",
  "description": "MediaListory - track games, movies, and series in one app. Games from IGDB (Twitch), movies/series from TMDB. Node/Express backend on Neon Postgres + Neon Auth with a static vanilla-JS frontend.",
  "main": "Backend/server.js",
  "scripts": {
    "start": "node Backend/server.js",
    "dev": "nodemon Backend/server.js",
    "test": "node --test ./test/unit/*.test.js ./test/smoke/*.test.js",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "games",
    "movies",
    "series",
    "igdb",
    "tmdb",
    "twitch",
    "neon",
    "express"
  ],
  "author": "Gr33nOps",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gr33nOps/medialistory-code.git"
  },
  "bugs": {
    "url": "https://github.com/Gr33nOps/medialistory-code/issues"
  },
  "homepage": "https://medialistory.vercel.app",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@sentry/node": "^10.74.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "morgan": "^1.10.0",
    "node-fetch": "^3.3.2",
    "pg": "^8.23.0"
  },
  "optionalDependencies": {
    "ioredis": "^6.0.0",
    "mysql2": "^3.24.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
