{
  "name": "medialistory",
  "version": "1.0.0",
  "description": "MediaListory: one library for movies, shows, anime, and games. A vanilla JavaScript frontend on Vercel, an API on Cloudflare Workers, and Neon Postgres.",
  "main": "Backend/server.js",
  "scripts": {
    "start": "node Backend/server.js",
    "dev": "nodemon Backend/server.js",
    "test": "node --test ./test/unit/*.test.js ./test/smoke/*.test.js",
    "test:e2e": "playwright test",
    "test:ui": "node test/e2e/ui-polish.cjs",
    "test:worker": "node --test --test-concurrency=1 ./test/worker/*.test.js",
    "dev:worker": "wrangler dev --env= --assets Frontend",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env="
  },
  "keywords": [
    "media-tracker",
    "movies",
    "tv-shows",
    "anime",
    "games",
    "tmdb",
    "kitsu",
    "igdb",
    "cloudflare-workers",
    "neon",
    "postgresql",
    "vanilla-js"
  ],
  "author": "Gr33nOps",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gr33nOps/medialistory.git"
  },
  "bugs": {
    "url": "https://github.com/Gr33nOps/medialistory/issues"
  },
  "homepage": "https://medialistory.vercel.app",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@sentry/cloudflare": "^11.1.0",
    "@sentry/node": "^11.0.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "knex": "^3.3.0",
    "morgan": "^1.12.1",
    "pg": "^8.23.0"
  },
  "optionalDependencies": {
    "ioredis": "^6.0.0",
    "mysql2": "^3.24.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "jsdom": "^30.1.1",
    "jsonwebtoken": "^9.0.3",
    "nodemon": "^3.1.14",
    "wrangler": "^4.147.0"
  }
}
